{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mysql-exam-studio",
  "build": {
    "command": "cd app && bun install && bun run build"
  },
  "main": "app/dist/server/server.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "assets": {
    "directory": "./app/dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "vars": {
    "HF_ENV": "production",
    "APP_SLUG": "mysql-exam-studio"
  }
}
